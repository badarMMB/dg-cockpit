# Copier ce fichier en .env et adapter les valeurs avant le premier déploiement

# Adresse IP ou nom de domaine du serveur (utilisé pour les URLs publiques MinIO)
SERVER_HOST=localhost

# Port d'accès à l'application
APP_PORT=8080

# Identifiants base de données
DB_USER=ged_user
DB_PASSWORD=ged_password

# Identifiants MinIO (stockage fichiers)
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
